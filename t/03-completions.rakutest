use Test;
use REPL;

plan 7;

my constant &sc = &standard-completions;

is-deeply sc("\\123"), ("¹²³","₁₂₃"), "super/subscripting integers";

is-deeply sc("shout!"), 
  ("SHOUT","shout","Shout"),
  "shouting whole line";

is-deeply sc("foo bar!"),
  ("foo BAR","foo bar","foo Bar"),
  "shouting last word";

is-deeply sc("foo bar! baz", 8),
  ("foo BAR","foo bar","foo Bar"),
  "shouting middle word";

my $repl = REPL.new;
is-deeply $repl.additional-completions.map(* ~~ Callable).List,
  (True, True),
  "default additional completions are all Callable";

if uniname-words() {
    is-deeply sc("\\c[LOVE"),
      ("\\c[I LOVE YOU HAND SIGN]", "\\c[LOVE HOTEL]", "\\c[LOVE LETTER]"),
      "testing \\c[word]";
    is-deeply sc("\\LOVE"),
      ("🤟", "🏩", "💌"),
      "testing \\word";
}
else {
    skip-rest "uniname-words module not installed";
}

# vim: expandtab shiftwidth=4
